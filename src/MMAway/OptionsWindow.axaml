<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MMAway.OptionsWindow"
        Title="MMAway Options"
        Width="428" Height="600"
        CanResize="False"
        WindowStartupLocation="CenterOwner">
  <Grid RowDefinitions="*,Auto,Auto" Margin="26">
    <TabControl Grid.Row="0">
      <TabItem Header="General">
        <StackPanel Spacing="18" Margin="12">
          <StackPanel Spacing="4">
            <TextBlock Text="Global hotkey" FontSize="16" FontWeight="SemiBold" />
            <TextBox Name="HotkeyBox" Watermark="Ctrl+Alt+M" Width="114" HorizontalAlignment="Left" />
            <TextBlock Text="Use Ctrl, Alt, Shift, or Win with A-Z, 0-9, F1-F12, Space, Enter, Esc, or Tab."
                       TextWrapping="Wrap" FontSize="11" />
          </StackPanel>

          <StackPanel Spacing="4">
            <TextBlock Text="Auto-stop (minutes; 0 disables)" FontSize="16" FontWeight="SemiBold" />
            <TextBox Name="AutoStopBox" Watermark="0" Width="204" HorizontalAlignment="Left" />
            <TextBlock Text="Activity stops automatically after this many minutes. Enter 0 to disable auto-stop."
                       TextWrapping="Wrap" FontSize="11" />
          </StackPanel>

          <StackPanel Spacing="4">
            <TextBlock Text="Activity interval (seconds)" FontSize="16" FontWeight="SemiBold" />
            <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
              <StackPanel Grid.Column="0" Spacing="4">
                <TextBlock Text="Minimum" />
                <TextBox Name="MinimumIntervalBox" Watermark="5" Width="85" HorizontalAlignment="Left" />
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="4">
                <TextBlock Text="Maximum" />
                <TextBox Name="MaximumIntervalBox" Watermark="15" Width="85" HorizontalAlignment="Left" />
              </StackPanel>
            </Grid>
          </StackPanel>

          <CheckBox Name="ShowSessionInfoBox" Content="Show session time and activity count" />
        </StackPanel>
      </TabItem>

      <TabItem Header="Mouse">
        <StackPanel Spacing="18" Margin="12">
          <StackPanel Spacing="4">
            <TextBlock Text="Resume after cursor is idle (seconds)" FontSize="16" FontWeight="SemiBold" />
            <TextBox Name="UserIdleSecondsBox" Watermark="10" Width="85" HorizontalAlignment="Left" />
            <TextBlock Text="Automated activity resumes after the cursor remains still for this long."
                       TextWrapping="Wrap" FontSize="11" />
          </StackPanel>

          <StackPanel Spacing="4">
            <TextBlock Text="Movement pattern" FontSize="16" FontWeight="SemiBold" />
            <Button Name="PatternButton" HorizontalContentAlignment="Left" Click="OnPatternButtonClick"
                    Content="Random (all patterns)" />
            <Popup Name="PatternPopup" PlacementTarget="{Binding #PatternButton}"
                   Placement="Bottom" IsLightDismissEnabled="True">
              <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                      BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                      BorderThickness="1" Padding="10" MinWidth="250" MaxHeight="260">
                <ScrollViewer>
                  <StackPanel Name="PatternChoices" Spacing="4" />
                </ScrollViewer>
              </Border>
            </Popup>
          </StackPanel>

          <StackPanel Spacing="4">
            <TextBlock Text="Movement speed" FontSize="16" FontWeight="SemiBold" />
            <Slider Name="AggressivenessSlider" HorizontalAlignment="Stretch"
                    Minimum="0.5" Maximum="3" TickFrequency="0.1" IsSnapToTickEnabled="True" />
            <TextBlock Name="AggressivenessValue" HorizontalAlignment="Stretch" TextAlignment="Right" />
            <TextBlock Text="Scales each movement's 2–5 second duration: 0.5x is slower, 1.0x is current, 3.0x is faster."
                       TextWrapping="Wrap" FontSize="11" />
          </StackPanel>
        </StackPanel>
      </TabItem>

      <TabItem Header="Keyboard">
        <StackPanel Spacing="14" Margin="12">
          <CheckBox Name="TypingEnabledBox" Content="Enable typing in the activity display" />
          <TextBlock Text="This only adds generated random characters to MMAway's own text box; it does not type into other apps."
                     TextWrapping="Wrap" FontSize="11" />
          <StackPanel Spacing="4">
            <TextBlock Text="Delay between typing bursts (seconds)" FontSize="16" FontWeight="SemiBold" />
            <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
              <StackPanel Grid.Column="0" Spacing="4">
                <TextBlock Text="Minimum" />
                <TextBox Name="TypingIntervalMinimumBox" Watermark="5" Width="85" HorizontalAlignment="Left" />
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="4">
                <TextBlock Text="Maximum" />
                <TextBox Name="TypingIntervalMaximumBox" Watermark="15" Width="85" HorizontalAlignment="Left" />
              </StackPanel>
            </Grid>
          </StackPanel>
          <StackPanel Spacing="4">
            <TextBlock Text="Characters per burst" FontSize="16" FontWeight="SemiBold" />
            <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
              <StackPanel Grid.Column="0" Spacing="4">
                <TextBlock Text="Minimum" />
                <TextBox Name="TypingBurstMinimumBox" Watermark="2" Width="85" HorizontalAlignment="Left" />
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="4">
                <TextBlock Text="Maximum" />
                <TextBox Name="TypingBurstMaximumBox" Watermark="20" Width="85" HorizontalAlignment="Left" />
              </StackPanel>
            </Grid>
          </StackPanel>
          <CheckBox Name="TypingSpacesBox" Content="Include spaces" />
          <StackPanel Name="SpaceFrequencyPanel" Spacing="4">
            <TextBlock Text="Characters between spaces" FontSize="16" FontWeight="SemiBold" />
            <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
              <StackPanel Grid.Column="0" Spacing="4">
                <TextBlock Text="Minimum" />
                <TextBox Name="SpaceMinimumBox" Watermark="0" Width="85" HorizontalAlignment="Left" />
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="4">
                <TextBlock Text="Maximum" />
                <TextBox Name="SpaceMaximumBox" Watermark="6" Width="85" HorizontalAlignment="Left" />
              </StackPanel>
            </Grid>
          </StackPanel>
        </StackPanel>
      </TabItem>
    </TabControl>

    <TextBlock Grid.Row="1" Name="ErrorText" Foreground="Red" TextWrapping="Wrap"
               IsVisible="False" Margin="12,4,12,0" />

    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"
                Spacing="10" Margin="0,12,0,0">
      <Button Content="Reset to defaults" Click="OnResetClick" />
      <Button Content="Cancel" Click="OnCancelClick" />
      <Button Content="Save" IsDefault="True" Click="OnSaveClick" />
    </StackPanel>
  </Grid>
</Window>
